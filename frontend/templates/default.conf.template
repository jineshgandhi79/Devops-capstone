# Rendered at container start by the nginx image's envsubst entrypoint
# (only variables defined in the environment, such as NGINX_LOCAL_RESOLVERS, are replaced).
server {
    listen 8080;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Resolve the backend per request rather than at startup, so the frontend
    # still starts (and serves the UI) when the backend name is not resolvable.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # API calls go to the backend. In Kubernetes the Ingress routes /api
    # before it reaches this container; this block serves docker-compose.
    location /api/ {
        set $backend_upstream http://devtrack-backend:8000;
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Single-page app: unknown paths fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Fingerprinted build assets can be cached for a long time
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
}
