# DevTrack Environment Configuration Template
# Copy this file to .env and adjust variables for your local setup:
# cp .env.example .env

# Backend API Settings
APP_ENV=development
API_PORT=8000

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devtrack

# SQLAlchemy Database URL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/devtrack
